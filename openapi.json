      "status": "Terbuka"
    },
    {
      "id": "Q-14",
      "topic": "Konfirmasi apakah data ID Proyek dan penugasan PM tersedia di dalam data kontrak",
      "owner": "Zaki Ramadhan Wijaya (usulan), F-2",
      "target": "Belum ditetapkan",
      "status": "Terbuka"
    },
    {
      "id": "OPEN-01",
      "topic": "Skema autentikasi dan format galat final",
      "owner": "F-1/F-5/E-2, perwakilan belum ditetapkan",
      "target": "Belum ditetapkan",
      "status": "Terbuka"
    }
  ]
}
